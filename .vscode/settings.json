{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": false
  },
  "[mdx]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": false
  },
  "editor.wordWrap": "on",
  "editor.rulers": [100],
  "prettier.proseWrap": "always",
  "files.associations": {
    "*.mdx": "mdx"
  }
}
